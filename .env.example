# Generate a VAPID key pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Better Auth (MongoDB)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated trusted browser origins. In production include only your HTTPS domain(s).
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
MONGODB_URI=

# Set exactly "false" only while configuring roles locally. When unset, role authorization is enforced.
# AuthorizationEnable=false

# Google OAuth 2.0 (add http://localhost:3000/api/auth/v1/callback/google to your Google OAuth redirect URIs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail SMTP password-reset delivery (use a Google App Password)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Redis cache and shared counters (dashboard sidebar/role cache and rate limits)
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379

# Set only when your reverse proxy overwrites this header with the client IP.
# Direct Vercel deployments use x-vercel-forwarded-for automatically.
# TRUSTED_CLIENT_IP_HEADER=x-forwarded-for

# ImageBB media uploads
NEXT_PUBLIC_IMGBB_API_KEY=

# UploadThing media uploads (v7 token from the UploadThing dashboard)
UPLOADTHING_TOKEN=

AuthorizationEnable=true
